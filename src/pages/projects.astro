---
import ProjectRows from "../components/ProjectRows.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Projects — Sajad"
  description="Selected backend, applied AI, developer-tools, and systems projects by Sajad."
  page="projects"
  canonical="https://sajadxdp0.github.io/projects.html"
>
  <main id="main" tabindex="-1">
    <section class="page-intro">
      <h1>Projects</h1>
      <p>Backend, applied AI, developer tools, and Android systems.</p>
    </section>
    <section class="project-list" aria-label="Projects">
      <ProjectRows />
    </section>
  </main>
  </BaseLayout>
