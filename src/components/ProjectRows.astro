---
interface Props {
  selectedOnly?: boolean;
}

const { selectedOnly = false } = Astro.props;

const projects = [
  {
    name: "HookFlow",
    href: "https://github.com/sajadxdp0/hookflow",
    description: "Webhook delivery with retries, signatures, and dead-letter replay.",
    selected: true,
  },
  {
    name: "Lexora",
    href: "https://github.com/sajadxdp0/lexora-ai",
    description: "Document Q&A with cited answers and per-user retrieval.",
    selected: true,
  },
  {
    name: "neuDB",
    href: "https://github.com/sajadxdp0/neudb",
    description: "Embedded Python database with JSON tables and semantic search.",
    selected: true,
    links: [{ label: "PyPI", href: "https://pypi.org/project/neudb/" }],
  },
  {
    name: "Tuxport",
    href: "https://github.com/sajadxdp0/tuxport",
    description: "Android terminal for Alpine Linux and ARM64 binaries, without root.",
    links: [{ label: "Website", href: "https://sajadxdp0.github.io/tuxport/" }],
  },
  {
    name: "EsenceLab",
    href: "https://github.com/sajadxdp0/esencelab",
    description: "Resume parsing and skill matching for recruiter shortlists.",
    links: [{ label: "Live site", href: "https://esencelab.vercel.app" }],
  },
  {
    name: "Helium for Android",
    href: "https://github.com/sajadxdp0/helium-android",
    description: "Android browser built with Compose, GeckoView, and Rust.",
  },
];

const visibleProjects = selectedOnly
  ? projects.filter((project) => project.selected)
  : projects;
---
<ul class="project-list">
  {visibleProjects.map((project) => (
    <li>
      <a class="project-name" href={project.href}>{project.name}</a>
      <p>{project.description}</p>
      {project.links?.map((link) => (
        <p class="project-extra"><a href={link.href}>{link.label}</a></p>
      ))}
    </li>
  ))}
</ul>
