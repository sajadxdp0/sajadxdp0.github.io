---
import "../styles/portfolio.css";
interface Props {
  title: string;
  description: string;
  page: "about" | "projects" | "contact" | null;
  canonical: string;
  noindex?: boolean;
}

const { title, description, page, canonical, noindex = false } = Astro.props;
const currentYear = new Date().getFullYear();
const site = Astro.site ?? new URL("https://sajadxdp0.github.io");
const ogImage = new URL("/og.png", site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <meta name="author" content="Abdulla Sajad" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/fonts/jbmnf-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/jbmnf-bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sajad" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sajad, software engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Sajad, software engineer" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <div class="site-backdrop" aria-hidden="true">
      <picture>
        <source media="(prefers-reduced-motion: reduce)" srcset="/wallpapers/cloud-drift-static.webp" type="image/webp" />
        <img
          src="/wallpapers/cloud-drift.svg"
          alt=""
          fetchpriority="low"
          decoding="async"
          draggable="false"
        />
      </picture>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Sajad, home"><span class="mark">sajad<span aria-hidden="true">.</span></span></a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/" aria-current={page === "about" ? "page" : undefined}>Home</a>
        <a href="/projects.html" aria-current={page === "projects" ? "page" : undefined}>Projects</a>
        <a href="/contact.html" aria-current={page === "contact" ? "page" : undefined}>Contact</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>&copy; <time>{currentYear}</time> Sajad</p>
    </footer>
  </body>
</html>
