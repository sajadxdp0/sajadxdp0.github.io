          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false">
            <rect x="2.75" y="4.75" width="18.5" height="14.5" rx="2" />
            <path d="m3.5 6 8.5 6.25L20.5 6" />
