---
const projects = [
  {
    name: "Osmium Android",
    href: "https://github.com/sajadxdp0/osmium-android",
    description: "A Rust-first Android browser with Material 3 Expressive and Mozilla GeckoView.",
    links: [{ label: "Latest release", href: "https://github.com/sajadxdp0/osmium-android/releases/latest" }],
  },
  {
    name: "Keepsake",
    href: "https://github.com/sajadxdp0/keepsake",
    description: "A browser-based image editor for adding styled names and exporting full-resolution PNGs.",
    links: [{ label: "Live site", href: "https://buildathon-keepsake.vercel.app" }],
  },
  {
    name: "Klear",
    href: "https://github.com/sajadxdp0/klear",
    description: "A Cashfree merchant back office for three-way reconciliation, payment recovery, and explainable fraud checks.",
  },
  {
    name: "FreightPilot AI",
    href: "https://github.com/sajadxdp0/FreightPilot-AI",
    description: "A sandbox prototype exploring evidence-grounded freight booking assistance.",
    links: [{ label: "Project notes", href: "/freightpilot-ai.html" }],
  },
  {
    name: "Tuxport",
    href: "https://github.com/sajadxdp0/tuxport",
    description: "A high-performance Linux terminal for Android with Alpine Linux bundled and no root required.",
    links: [{ label: "Website", href: "https://sajadxdp0.github.io/tuxport/" }],
  },
  {
    name: "HookFlow",
    href: "https://github.com/sajadxdp0/hookflow",
    description: "Persist-first webhook delivery with signed payloads, retries, idempotency, and a dead-letter queue.",
  },
  {
    name: "Lexora",
    href: "https://github.com/sajadxdp0/lexora-ai",
    description: "Document Q&A with cited sources, per-user retrieval, and streaming answers.",
  },
  {
    name: "neuDB",
    href: "https://github.com/sajadxdp0/neudb",
    description: "Embedded Python database with JSON tables, atomic writes, and semantic search.",
    links: [
      { label: "PyPI", href: "https://pypi.org/project/neudb/" },
      { label: "Website", href: "https://sajadxdp0.github.io/neudb/" },
    ],
  },
  {
    name: "EsenceLab",
    href: "https://github.com/sajadxdp0/esencelab",
    description: "Hiring platform with resume parsing, skill matching, and recruiter shortlists.",
    links: [{ label: "Live site", href: "https://esencelab.vercel.app" }],
  },
];

---
<ul class="project-list">
  {projects.map((project) => (
    <li>
      <a class="project-name" href={project.href}>{project.name}</a>
      <p>{project.description}</p>
      {project.links?.map((link) => (
        <p class="project-extra"><a href={link.href}>{link.label}</a></p>
      ))}
    </li>
  ))}
</ul>
